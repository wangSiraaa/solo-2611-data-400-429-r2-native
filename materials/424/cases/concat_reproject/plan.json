            {"op": "add", "args": [{"field": "gross"}, {"field": "tax"}]},
            {"field": "net"}
          ]
        },
        "amount_plus_one": {
          "op": "add",
          "args": [
            {
              "op": "if",
              "args": [
                {"op": "eq", "args": [{"field": "kind"}, {"const": "sale"}]},
                {"op": "add", "args": [{"field": "gross"}, {"field": "tax"}]},
                {"field": "net"}
              ]
            },
            {"const": 1}
          ]
        }
      }
    }
  ],
  "output": "unified"
