  "prerequisite_explanation": {
    "INNER": [
      "FOREIGN_KEY(child.parent_id->parent.id) 保证非NULL子键必有父，否则孤儿/NULL子行会被INNER删除",
      "NOT_NULL(child.parent_id) 保证子键无NULL，SQL等值连接NULL不匹配",
      "UNIQUE(parent.id) 保证每个子键至多一个父匹配，否则父重复放大行数"
    ],
    "LEFT": [
      "仅需 UNIQUE(parent.id)：LEFT无匹配时本就保留左行，NULL子键与无匹配子键都不会被丢弃"
    ]
  }
